# =====================================
# Git Ignore for Ecommerce Platform
# =====================================

# Environment Variables & Secrets
.env
.env.*
!.env.example
*.pem
*.key

# SQLite Database (Do not push real databases or customer data to GitHub!)
*.sqlite3
*.sqlite3-journal
*.db

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Node & Frontend Build
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.oxlintrc.json
node_modules/
dist/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Static & Media root uploads
staticfiles/
media/

# IDE & Editor Files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# Scratch & Temporary local utilities
process_icons.py
