# =========================================================
# Django E-Commerce Platform - Environment Variables Template
# =========================================================
# Copy this file to .env and configure values for your environment.
# DO NOT commit the .env file with real secrets to GitHub!

# Django Security Settings
DJANGO_SECRET_KEY=your-secure-random-secret-key-here-minimum-50-characters
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Obscure Admin URL (Best Practice: change from default 'admin/' in production)
DJANGO_ADMIN_URL=admin/

# CORS Configuration (Comma-separated list of allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# SSL / HTTPS Settings (Enable in production behind reverse proxy/HTTPS)
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False

# Database Configuration (Optional: defaults to SQLite for local development)
# DATABASE_URL=postgres://user:password@localhost:5432/ecommerce_db
